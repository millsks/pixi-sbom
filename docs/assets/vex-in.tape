# A vendor's VEX clears the known-exploited finding the gate failed on.
#
# Regenerated by `pixi run demo`. See docs/development.md; the input is staged by
# scripts/demo-workspace.sh so the run needs no network and looks the same every time.

Output "docs/assets/vex-in.gif"
Source "docs/assets/_common.tape"
Set Height 320

Hide
Type `cd "$DEMO_WORKSPACE" && PS1='$ '` Enter
Type "clear" Enter
Ctrl+L
Show

Sleep 400ms
Type "pixi sbom -e web -p linux-64 -q --vulnerabilities osv --kev --fail-on-kev" Sleep 200ms Enter
Sleep 2000ms
Type "pixi sbom -e web -p linux-64 -q --vulnerabilities osv --kev --fail-on-kev --vex-in vendor.openvex.json && echo passed" Sleep 200ms Enter
Sleep 1800ms
Type "pixi sbom -e web -p linux-64 -q --vulnerabilities osv --vex-in vendor.openvex.json --report vulnerabilities | grep -A1 Ignored" Sleep 200ms Enter
Sleep 3200ms
